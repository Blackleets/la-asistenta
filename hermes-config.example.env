# ============================================================================
# La Asistenta — variables de entorno de Hermes Agent (EJEMPLO)
# ============================================================================
# Copia este fichero como ".env" dentro de HERMES_HOME
# (~/workspace/la-asistenta/hermes-home/.env) cuando llegue la clave real,
# y sustituye el placeholder por la clave de Baseten que Lee guarda en la
# bóveda segura. NUNCA pegues una clave real en este fichero de ejemplo
# ni la subas a ningún repo.
#
# La config de Hermes (config.yaml) referencia esta variable con key_env:
#   providers.baseten.key_env: BASETEN_API_KEY
# ============================================================================

# Clave de API de Baseten (Muse Spark Open, créditos del hackathon Meta).
# Placeholder — sustituir SOLO en la copia real (.env de hermes-home).
BASETEN_API_KEY=PEGA_AQUI_LA_CLAVE_DE_BASETEN

# Endpoint OpenAI-compatible de Baseten (informativo: la URL que usa
# Hermes sale de config.yaml -> providers.baseten.api, no de aquí).
# BASETEN_BASE_URL=https://inference.baseten.co/v1
