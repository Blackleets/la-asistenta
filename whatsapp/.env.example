# La Asistenta · webhook de WhatsApp — EJEMPLO de configuración.
# Copia este fichero a ".env" (misma carpeta) y rellena los valores REALES
# desde el panel de Meta cuando se haga el paso del navegador.
# NUNCA subas el .env real a ningún repo ni lo pegues en chats.

# Token de verificación del webhook: lo inventas TÚ (una cadena secreta) y lo
# pegas TAL CUAL en el panel de Meta al configurar el webhook. El de abajo es
# un EJEMPLO generado al azar para enseñar el formato: genera el tuyo propio
# (p. ej. python3 -c "import secrets; print(secrets.token_hex(16))").
WHATSAPP_VERIFY_TOKEN=bf950841d9f70bf44925a35b86090497

# Secreto de la app de Meta (App Settings > Basic > App Secret).
# IMPRESCINDIBLE para verificar la firma X-Hub-Signature-256 de los POST.
# Sin él, los entrantes no se pueden autenticar (ver riesgos en H3_TECNICO.md).
WHATSAPP_APP_SECRET=

# Token de acceso de WhatsApp Cloud API (WhatsApp > API Setup).
# OJO: el token temporal caduca a las 24 h; para operar hay que crear un
# usuario del sistema en Meta Business y generar un token PERMANENTE.
WHATSAPP_TOKEN=

# ID del número de teléfono (phone_number_id, WhatsApp > API Setup).
# NO es el número en sí: es el identificador largo que muestra el panel.
WHATSAPP_PHONE_NUMBER_ID=

# Puerto local del receptor (el túnel HTTPS apuntará aquí).
PORT=8080

# Versión de la Graph API.
WHATSAPP_GRAPH_VERSION=v21.0

# --- Ruta C: Twilio WhatsApp Sandbox -------------------------------------
# El mismo servidor expone POST /twilio/webhook. Twilio manda los datos como
# formulario (From, Body, ProfileName, MessageSid) y espera una confirmación
# inmediata; con estas credenciales, la respuesta de Hermes se envía después
# por la API de Twilio, sin depender del límite de respuesta del webhook.
# Los valores reales salen de la consola de Twilio. NUNCA los subas al repo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública EXACTA configurada en Twilio (incluye /twilio/webhook). Solo se
# usa para validar X-Twilio-Signature cuando también existe TWILIO_AUTH_TOKEN.
TWILIO_WEBHOOK_PUBLIC_URL=
