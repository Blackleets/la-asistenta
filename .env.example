# =====================================================================
# LA ASISTENTA — variables de entorno (EJEMPLO, valores ficticios)
# Copia lo que necesites a un fichero ".env" local y rellena TUS valores.
# Nunca subas un .env real a este repositorio.
# =====================================================================

# ── Baseten / Muse Spark (cerebro de La Asistenta vía Hermes Agent) ──
# Clave de API de Baseten. En Hermes va en el .env de HERMES_HOME y la
# config la referencia con key_env (ver hermes-config.example.env).
BASETEN_API_KEY=pon-aqui-tu-clave-de-baseten

# ── API local de la agenda (agenda/agenda_api.py) ────────────────────
# Token que protege la API local de la agenda. En desarrollo, si no se
# define, el código usa un valor de demostración documentado; define el
# tuyo propio antes de cualquier uso fuera de tu máquina.
AGENDA_API_TOKEN=token-local-de-ejemplo-cambialo
AGENDA_API_PORT=8081

# ── WhatsApp Cloud API (whatsapp/webhook.py) ─────────────────────────
# El webhook tiene su propio ejemplo detallado en whatsapp/.env.example.
# Resumen de variables:
WHATSAPP_VERIFY_TOKEN=token-de-verificacion-que-tu-inventas
WHATSAPP_APP_SECRET=secreto-de-tu-app-de-meta
WHATSAPP_TOKEN=token-de-acceso-de-whatsapp-cloud-api
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_GRAPH_VERSION=v21.0
PORT=8080
